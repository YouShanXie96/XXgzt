# Server Configuration
PORT=3000

# Workbench Data Directory (relative or absolute path)
XX_DATA_DIR=.dev-data

# Standalone Mode: 1 = auto-login as local admin without external OmniHub auth server, 0 = require external auth server
XX_STANDALONE=1

# Optional external login center URL (only used when XX_STANDALONE=0)
# XX_LOGIN_CENTER_URL=https://xieys.de5.net
# XX_LOGIN_APP_ID=1001
